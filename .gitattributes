* text=auto
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.ico binary
# Preserve checksummed generated assets and verbatim upstream license files.
web/sqflite_sw.js text eol=lf
web/sqlite3.wasm binary
licenses/dependencies/*.txt -text
licenses/CAPSULES_MIT.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
assets/prompts/capsules.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/evidence/prompt-library/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
