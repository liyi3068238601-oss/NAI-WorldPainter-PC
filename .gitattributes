docs/evidence/assistant-live/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Original mobile resources are verified by exact-byte SHA-256 checks.
assets/assistant/mobile/** -text -whitespace

# Verbatim assistant resources copied into the Electron bundle keep source hashes.
desktop/public/worldpainter/mobile/** -text -whitespace
# Upstream audit inventory records this fixture's original CRLF bytes.
