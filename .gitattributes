# Keep checksummed Agent acceptance logs and fixture stable across Windows checkouts.
docs/evidence/agent-execution-v1/*.log text eol=lf
docs/evidence/agent-execution-v1/*.jsonl text eol=lf
scripts/agent-native-fixture.cjs text eol=lf
docs/evidence/agent-providers-v1/*.log text eol=lf
